#include <stdio.h>

int main() {
    int number;
    int total_sum = 0; 

   
    printf("Enter positive numbers to ADD (zero or negative number to STOP)\n\n");


    while (1) {
        
        printf("Enter a number: ");
        scanf("%d", &number);

        
        if (number <= 0) {
            break;
        }

        
        total_sum += number;
    }

    
    printf("Total sum is: %d\n", total_sum);

    return 0;
}
